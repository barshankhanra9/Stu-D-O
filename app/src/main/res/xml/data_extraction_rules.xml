<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="private_originals" />
        <exclude domain="file" path="studo_bin" />
        <exclude domain="file" path="portrait_sidecars" />
        <exclude domain="sharedpref" path="studo_camera_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="private_originals" />
        <exclude domain="file" path="studo_bin" />
        <exclude domain="file" path="portrait_sidecars" />
        <exclude domain="sharedpref" path="studo_camera_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
